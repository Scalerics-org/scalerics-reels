@@DUR
6.26
@@CSS
$ .s06-cap { position: absolute; left: 640px; top: 948px; width: 320px; text-align: center; font-family: "Outfit", sans-serif; font-weight: 900; font-size: 40px; color: #0b1a3a; }
$ .s06-donde { position: absolute; left: 610px; top: 590px; width: 380px; text-align: center; font-family: "Outfit", sans-serif; font-weight: 900; font-size: 44px; color: #f2c14e; }
$ .s06-cartel { left: 90px; top: 600px; width: 900px; font-size: 70px; white-space: normal; }
$ .s06-billete-txt { position: absolute; left: 700px; top: 838px; width: 220px; text-align: center; font-family: "Outfit", sans-serif; font-weight: 900; font-size: 64px; color: #f4f4f4; }
@@HTML
<svg class="lienzo" viewBox="0 0 1080 1920" aria-hidden="true">
  <g class="s06-mod-todo">
    {{moderadora 330 1040 1.4 s06-m}}
    <rect class="s06-tarjetas" x="380" y="1080" width="90" height="120" rx="8" fill="#f2c14e" stroke="#f4f4f4" stroke-width="4" transform="rotate(-12 425 1140)" />
    <path class="silueta s06-mesa" d="M90 1170 H560 L540 1290 H110 Z" />
    <path class="s06-mesa-banda" d="M90 1170 H560 L557 1206 H93 Z" fill="#f2c14e" />
  </g>
  <g class="s06-polaroid">
    <rect x="640" y="660" width="320" height="350" rx="10" fill="#f4f4f4" />
    <rect x="662" y="682" width="276" height="250" fill="#16306a" />
    <path class="linea s06-e" d="M716 932 C721 868 756 850 800 850 C844 850 879 868 884 932" />
    <circle class="linea s06-e" cx="800" cy="726" r="22" />
    <circle class="linea s06-e" cx="800" cy="796" r="48" />
    <path class="linea s06-e" d="M772 792 a12 12 0 1 0 24 0 a12 12 0 1 0 -24 0 M804 792 a12 12 0 1 0 24 0 a12 12 0 1 0 -24 0 M786 822 q14 9 28 0" style="stroke-width: 4" />
    <path class="dorado s06-e" d="M770 870 q30 18 60 0" style="stroke-dasharray: 2 12; stroke-width: 9" />
  </g>
  <g class="s06-due-todo">
    {{duenio 420 1080 1.6 s06-d}}
    <g class="s06-billete">
      <rect x="680" y="820" width="260" height="130" rx="10" fill="#0b1a3a" stroke="#f4f4f4" stroke-width="5" />
      <circle cx="810" cy="885" r="44" fill="none" stroke="#f4f4f4" stroke-width="4" />
      <path class="silueta" d="M560 1000 C600 960 640 930 690 910 L700 940 C660 960 620 990 590 1030 Z" />
    </g>
    <path class="linea s06-gota1" d="M520 880 q10 18 0 26 q-10 -8 0 -26 Z" />
    <path class="linea s06-gota2" d="M318 900 q10 18 0 26 q-10 -8 0 -26 Z" />
  </g>
</svg>
<div class="s06-cap">DOÑA ELSA</div>
<div class="s06-donde">¿DÓNDE ESTÁ?</div>
<div class="s06-billete-txt">US$</div>
<div class="cartel c-dorado s06-cartel">ESO NO ES LO QUE PREGUNTÉ</div>
@@JS
      const DONA = 1.0, VENIR = 2.0, MIRA = 2.87, DOLAR = 3.69, ESO = 4.5, PREGUNTE = 5.2;
      // la moderadora con sus tarjetas
      tl.fromTo(q(".s06-mod-todo"), { opacity: 0.5, x: -60 }, { opacity: 1, x: 0, duration: 0.35, ease: "power3.out" }, 0);
      dibujar([q(".s06-mesa")], 0, 0.4, 0.5);
      tl.to(q(".s06-tarjetas"), { rotation: -4, svgOrigin: "425 1200", duration: 0.25, yoyo: true, repeat: 3, ease: "sine.inOut" }, 0.4);
      // "Doña Elsa": la polaroid
      gsap.set(q(".s06-polaroid"), { opacity: 0 });
      tl.fromTo(q(".s06-polaroid"), { opacity: 0, rotation: 18, scale: 0.6, svgOrigin: "800 835" }, { opacity: 1, rotation: 5, scale: 1, svgOrigin: "800 835", duration: 0.4, ease: "back.out(1.6)", immediateRender: false }, DONA - 0.1);
      gsap.set(q(".s06-cap"), { opacity: 0, rotation: 5 });
      tl.to(q(".s06-cap"), { opacity: 1, duration: 0.2 }, DONA + 0.2);
      dibujar(qa(".s06-e"), DONA + 0.05, 0.4);
      pop(q(".s06-donde"), VENIR - 0.1);
      tl.to(q(".s06-donde"), { scale: 1.1, duration: 0.2, yoyo: true, repeat: 1 }, VENIR + 0.3);
      // "Mirá, el tema del dólar": corte al dueño
      tl.to([q(".s06-mod-todo"), q(".s06-polaroid"), q(".s06-cap"), q(".s06-donde")], { opacity: 0, duration: 0.15 }, MIRA - 0.18);
      gsap.set([q(".s06-due-todo"), q(".s06-billete-txt")], { opacity: 0 });
      tl.fromTo(q(".s06-due-todo"), { opacity: 0, x: 80 }, { opacity: 1, x: 0, duration: 0.3, ease: "power3.out", immediateRender: false }, MIRA - 0.05);
      tl.set(q(".s06-billete-txt"), { opacity: 1 }, MIRA + 0.25);
      gsap.set(q(".s06-billete"), { opacity: 0 });
      tl.fromTo(q(".s06-billete"), { opacity: 0, y: 60 }, { opacity: 1, y: 0, duration: 0.3, ease: "back.out(2)", immediateRender: false }, MIRA + 0.2);
      tl.fromTo([q(".s06-billete"), q(".s06-billete-txt")], { rotation: -6, svgOrigin: "590 1020" }, { rotation: 6, svgOrigin: "590 1020", duration: 0.18, yoyo: true, repeat: 7, ease: "sine.inOut", immediateRender: false }, DOLAR - 0.3);
      [[".s06-gota1", MIRA + 0.4], [".s06-gota2", DOLAR]].forEach(([s, t]) => {
        gsap.set(q(s), { opacity: 0 });
        tl.fromTo(q(s), { opacity: 0, y: 0 }, { opacity: 1, y: 70, duration: 0.8, ease: "power1.in", immediateRender: false }, t);
        tl.to(q(s), { opacity: 0, duration: 0.12 }, t + 0.8);
      });
      // "Eso no es lo que pregunté": cartel que aplasta
      gsap.set(q(".s06-cartel"), { opacity: 0 });
      tl.fromTo(q(".s06-cartel"), { opacity: 0, scale: 2.2, rotation: -2 }, { opacity: 1, scale: 1, rotation: -2, duration: 0.16, ease: "power4.in", immediateRender: false }, ESO - 0.08);
      temblor(q(".escenario"), ESO + 0.1, 0.8);
      tl.to(q(".s06-due-todo"), { scale: 0.85, svgOrigin: "420 1256", duration: 0.35, ease: "power2.out" }, ESO + 0.1);
      tl.to(q(".s06-billete-txt"), { opacity: 0, duration: 0.08 }, ESO + 0.05);
      tl.to(q(".s06-billete"), { opacity: 0, y: 200, duration: 0.4, ease: "power2.in" }, ESO + 0.1);
      tl.to(q(".s06-cartel"), { scale: 1.05, duration: 0.2, yoyo: true, repeat: 1 }, PREGUNTE);
      etiquetas([["LA PREGUNTA", 0.05], ["LA RESPUESTA", MIRA], ["SIN RESPUESTA", ESO + 0.2]]);
@@SFX
[{"t": 0.05, "sfx": "click", "vol": 0.3}, {"t": 0.95, "sfx": "pop", "vol": 0.35}, {"t": 2.0, "sfx": "drama", "vol": 0.2, "max": 0.8}, {"t": 3.1, "sfx": "whoosh-short", "vol": 0.25}, {"t": 4.42, "sfx": "impact-bass-1", "vol": 0.45, "max": 0.7}, {"t": 4.6, "sfx": "risas", "vol": 0.22, "max": 1.4}]
