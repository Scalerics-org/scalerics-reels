@@DUR
6.51
@@CSS
$ .s10-cel { position: absolute; left: 250px; top: 600px; width: 580px; height: 650px; border-radius: 54px; border: 6px solid #f4f4f4; background: #0b1a3a; box-sizing: border-box; overflow: hidden; }
$ .s10-cab { position: absolute; left: 0; right: 0; top: 0; height: 100px; background: #16306a; display: flex; align-items: center; gap: 16px; padding-left: 30px; font-family: "Lexend", sans-serif; font-weight: 600; font-size: 34px; color: #f4f4f4; }
$ .s10-av { width: 62px; height: 62px; border-radius: 50%; background: #f2c14e; color: #0b1a3a; font-family: "Outfit", sans-serif; font-weight: 800; font-size: 34px; line-height: 62px; text-align: center; }
$ .s10-g { white-space: normal; font-size: 38px; }
$ .s10-sello { left: 175px; top: 912px; font-size: 100px; }
$ .s10-grito { position: absolute; left: 70px; top: 640px; font-family: "Outfit", sans-serif; font-weight: 900; font-size: 160px; line-height: 1; color: #e63946; }
@@HTML
<div class="s10-cel">
  <div class="s10-cab"><div class="s10-av">E</div>Doña Elsa</div>
  <div class="hora s10-hora" style="left: 0; right: 0; top: 112px; text-align: center; color: #8b97ad">ANOCHE · 21:30</div>
  <div class="globo g-loc s10-g s10-g1" style="right: 26px; top: 150px; width: 470px">¡Doña Elsa! La extrañamos. Llegó lo que le gusta.</div>
  <div class="globo g-cli s10-g s10-g2" style="left: 26px; top: 452px; width: 400px">¡Ay, qué amor! El jueves paso.</div>
</div>
<div class="sello s-verde s10-sello">VERDADERO</div>
<svg class="lienzo" viewBox="0 0 1080 1920" aria-hidden="true">
  <g class="s10-pelea">
    {{duenio 300 1060 1.3 s10-d}}
    <path class="silueta s10-brazo" d="M380 1060 C430 1010 500 990 560 985 L562 1015 C505 1022 450 1040 410 1090 Z" />
    <circle class="silueta s10-dedo" cx="570" cy="1000" r="16" />
    <path class="linea" d="M256 908 l30 12 M344 908 l-30 12" />
    {{agente 830 1070 1.2 s10-a}}
    <path class="silueta" d="M90 1196 H520 L505 1286 H105 Z" />
    <path d="M90 1196 H520 L517 1230 H93 Z" fill="#e63946" />
    <path class="silueta" d="M620 1196 H1010 L996 1286 H634 Z" />
    <path d="M620 1196 H1010 L1007 1230 H623 Z" fill="#57c4e5" />
  </g>
</svg>
<div class="s10-grito">¡!</div>
@@JS
      const ELSA = 0.26, ESCRIBI = 0.92, VUELVE = 2.0, JUEVES = 2.42, VERDADERO = 3.28, ME = 4.52, SACAR = 4.97, PUESTO = 5.41;
      tl.fromTo(q(".s10-cel"), { opacity: 0.5, y: 80 }, { opacity: 1, y: 0, duration: 0.35, ease: "back.out(1.4)" }, 0);
      tl.to(q(".s10-av"), { scale: 1.2, duration: 0.15, yoyo: true, repeat: 1 }, ELSA);
      pop(q(".s10-hora"), ESCRIBI - 0.2);
      gsap.set(q(".s10-g1"), { opacity: 0 });
      tl.fromTo(q(".s10-g1"), { opacity: 0, x: 80 }, { opacity: 1, x: 0, duration: 0.3, ease: "back.out(1.6)", immediateRender: false }, ESCRIBI);
      pop(q(".s10-g2"), VUELVE);
      tl.to(q(".s10-g2"), { scale: 1.06, duration: 0.15, yoyo: true, repeat: 1 }, JUEVES);
      gsap.set(q(".s10-d-boca"), { scaleY: -1, svgOrigin: "0 -31" });
      // VERDADERO
      sello(q(".s10-sello"), VERDADERO, -8);
      // "¡Me viene a sacar el puesto!": el dueño acusa
      tl.to([q(".s10-cel"), q(".s10-sello")], { opacity: 0, duration: 0.2 }, ME - 0.25);
      gsap.set(q(".s10-pelea"), { opacity: 0 });
      tl.fromTo(q(".s10-pelea"), { opacity: 0, scale: 1.1, svgOrigin: "540 1100" }, { opacity: 1, scale: 1, svgOrigin: "540 1100", duration: 0.25, ease: "power3.out", immediateRender: false }, ME - 0.1);
      gsap.set([q(".s10-brazo"), q(".s10-dedo")], { opacity: 0 });
      tl.fromTo([q(".s10-brazo"), q(".s10-dedo")], { opacity: 0, x: -60 }, { opacity: 1, x: 0, duration: 0.2, ease: "back.out(2)", immediateRender: false }, SACAR - 0.1);
      tl.to([q(".s10-brazo"), q(".s10-dedo")], { x: 14, duration: 0.08, yoyo: true, repeat: 7 }, SACAR + 0.15);
      gsap.set(q(".s10-grito"), { opacity: 0 });
      tl.fromTo(q(".s10-grito"), { opacity: 0, scale: 2.2 }, { opacity: 1, scale: 1, duration: 0.14, ease: "power4.in", immediateRender: false }, PUESTO - 0.1);
      temblor(q(".escenario"), PUESTO + 0.05, 0.7);
      tl.to(q(".s10-a-ojos"), { scaleY: 0.1, svgOrigin: "0 -104", duration: 0.06, yoyo: true, repeat: 1 }, PUESTO + 0.4);
      etiquetas([["SEGUIMIENTO", 0.05], ["VUELVE EL JUEVES", VUELVE], ["PROMESA: VERDADERA", VERDADERO], ["ACUSACIÓN", ME]]);
@@SFX
[{"t": 0.92, "sfx": "notification", "vol": 0.3}, {"t": 2.0, "sfx": "ping", "vol": 0.3}, {"t": 3.16, "sfx": "impact-bass-1", "vol": 0.4, "max": 0.7}, {"t": 3.2, "sfx": "chime", "vol": 0.3}, {"t": 3.3, "sfx": "aplausos", "vol": 0.35}, {"t": 4.95, "sfx": "whoosh-short", "vol": 0.25}, {"t": 5.35, "sfx": "impact-bass-2", "vol": 0.3, "max": 0.5}]
