@@DUR
6.05
@@CSS
$ .s07-cartel { left: 140px; top: 588px; width: 800px; font-size: 60px; transform: rotate(-2deg); }
$ .s07-cartel small { display: block; font-size: 34px; letter-spacing: 0.06em; margin-top: 8px; }
$ .s07-tarjeta { left: 110px; top: 600px; width: 860px; height: 540px; }
$ .s07-cab { position: absolute; left: 40px; top: 92px; display: flex; align-items: center; gap: 18px; font-family: "Lexend", sans-serif; font-weight: 600; font-size: 40px; color: #0b1a3a; }
$ .s07-av { width: 70px; height: 70px; border-radius: 50%; background: #0b1a3a; color: #f4f4f4; font-family: "Outfit", sans-serif; font-weight: 800; font-size: 38px; line-height: 70px; text-align: center; }
$ .s07-vacio { position: absolute; left: 40px; right: 40px; top: 190px; height: 230px; border: 4px dashed #b7c2d8; border-radius: 20px; box-sizing: border-box; }
$ .s07-nadie { position: absolute; left: 0; right: 0; top: 440px; text-align: center; font-family: "IBM Plex Mono", monospace; font-weight: 500; font-size: 30px; letter-spacing: 0.1em; color: #e63946; }
$ .s07-copo { position: absolute; left: 90px; top: 210px; width: 200px; height: 200px; }
$ .s07-copo path { fill: none; stroke: #57c4e5; stroke-width: 7; stroke-linecap: round; }
$ .s07-sello { left: 400px; top: 800px; font-size: 120px; }
$ .s07-uuh { top: 1168px; font-size: 110px; color: #f2c14e; letter-spacing: 0.08em; }
$ .s07-uuh span { display: inline-block; }
@@HTML
<svg class="lienzo" viewBox="0 0 1080 1920" aria-hidden="true">
  <g class="s07-due">
    {{duenio 540 1040 1.6 s07-d}}
    <g transform="translate(540 1040) scale(1.6)">
      <path class="silueta" d="M-112 70 C-100 30 -60 40 -14 62 L-20 86 C-60 74 -84 72 -96 104 Z" />
      <path class="silueta" d="M112 70 C100 30 60 40 14 62 L20 86 C60 74 84 72 96 104 Z" />
      <circle class="silueta" cx="-6" cy="70" r="20" /><circle class="silueta" cx="6" cy="76" r="20" />
      <path class="celeste s07-lagrima" d="M-24 -76 q8 16 0 24 q-8 -8 0 -24 Z" style="stroke-width: 4" />
    </g>
  </g>
  <path class="silueta s07-atril" d="M250 1196 H830 L810 1286 H270 Z" />
  <path class="s07-banda" d="M250 1196 H830 L827 1232 H253 Z" fill="#e63946" />
</svg>
<div class="cartel c-rojo s07-cartel">ME ACUERDO DE TODOS<small>Y DE DOÑA ELSA</small></div>
<div class="tarjeta s07-tarjeta">
  <div class="cinta">CHEQUEO DE DATOS</div>
  <div class="s07-cab"><div class="s07-av">E</div>Doña Elsa</div>
  <div class="s07-vacio"></div>
  <svg class="s07-copo" viewBox="0 0 200 200" aria-hidden="true"><path d="M100 20 V180 M30 60 L170 140 M30 140 L170 60 M80 30 L100 50 L120 30 M80 170 L100 150 L120 170" /></svg>
  <div class="s07-nadie">ÚLTIMO MENSAJE: INVIERNO</div>
</div>
<div class="sello s07-sello">FALSO</div>
<div class="grande s07-uuh"><span>U</span><span>U</span><span>U</span><span>U</span><span>H</span></div>
@@JS
      const ACORDARME = 0.45, ELSA = 1.52, NADIE = 2.45, INVIERNO = 3.61, FALSO = 4.46, UUH = 4.95;
      tl.fromTo(q(".s07-due"), { y: 30, opacity: 0.6 }, { y: 0, opacity: 1, duration: 0.3, ease: "power2.out" }, 0);
      dibujar([q(".s07-atril")], 0, 0.4, 0.5);
      gsap.set(q(".s07-cartel"), { opacity: 0 });
      tl.fromTo(q(".s07-cartel"), { opacity: 0, y: -240 }, { opacity: 1, y: 0, duration: 0.4, ease: "bounce.out", immediateRender: false }, ACORDARME - 0.15);
      // se emociona: lágrima y se balancea
      gsap.set(q(".s07-lagrima"), { opacity: 0 });
      tl.fromTo(q(".s07-lagrima"), { opacity: 1, y: 0 }, { opacity: 1, y: 40, duration: 0.8, ease: "power1.in", immediateRender: false }, ELSA - 0.3);
      tl.to(q(".s07-lagrima"), { opacity: 0, duration: 0.1 }, ELSA + 0.5);
      tl.to(q(".s07-due"), { rotation: 3, svgOrigin: "540 1210", duration: 0.4, yoyo: true, repeat: 3, ease: "sine.inOut" }, ACORDARME);
      // "Nadie le escribe": la tarjeta de chequeo tapa todo
      gsap.set(q(".s07-tarjeta"), { opacity: 0 });
      tl.fromTo(q(".s07-tarjeta"), { opacity: 0, y: 200 }, { opacity: 1, y: 0, duration: 0.35, ease: "back.out(1.4)", immediateRender: false }, NADIE - 0.2);
      tl.to([q(".s07-cartel"), q(".s07-due"), q(".s07-atril"), q(".s07-banda")], { opacity: 0, duration: 0.2 }, NADIE - 0.1);
      gsap.set(qa(".s07-copo path"), { opacity: 0 });
      dibujar(qa(".s07-copo path"), INVIERNO - 0.3, 0.4);
      tl.fromTo(q(".s07-copo"), { rotation: 0 }, { rotation: 60, duration: 2.4, ease: "none" }, INVIERNO - 0.3);
      pop(q(".s07-nadie"), INVIERNO);
      sello(q(".s07-sello"), FALSO, -8);
      // el público: uuuh
      qa(".s07-uuh span").forEach((sp, i) => {
        gsap.set(sp, { opacity: 0 });
        tl.fromTo(sp, { opacity: 0, y: 60 }, { opacity: 1, y: 0, duration: 0.25, ease: "back.out(3)", immediateRender: false }, UUH + i * 0.06);
        tl.to(sp, { y: -18, duration: 0.2, yoyo: true, repeat: 1, ease: "sine.inOut" }, UUH + 0.4 + i * 0.06);
      });
      etiquetas([["PROMESA Nº 3", 0.05], ["CHEQUEO DE DATOS", NADIE], ["EL PÚBLICO OPINA", UUH]]);
@@SFX
[{"t": 0.35, "sfx": "whoosh", "vol": 0.22}, {"t": 1.3, "sfx": "sparkle", "vol": 0.2}, {"t": 2.3, "sfx": "beep", "vol": 0.3}, {"t": 3.5, "sfx": "chime", "vol": 0.2}, {"t": 4.34, "sfx": "impact-bass-1", "vol": 0.45, "max": 0.7}, {"t": 4.85, "sfx": "uuh", "vol": 0.45}]
