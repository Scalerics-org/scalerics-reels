@@DUR
4.49
@@CSS
$ .s09-prom { position: absolute; left: 190px; width: 700px; font-size: 54px; }
$ .s09-tacha { position: absolute; left: -20px; right: -20px; top: 50%; height: 12px; margin-top: -6px; background: #f4f4f4; border-radius: 6px; transform-origin: 0 50%; }
$ .s09-cel { position: absolute; left: 270px; top: 600px; width: 540px; height: 680px; border-radius: 54px; border: 6px solid #f4f4f4; background: #0b1a3a; box-sizing: border-box; overflow: hidden; }
$ .s09-cab { position: absolute; left: 0; right: 0; top: 0; height: 100px; background: #16306a; display: flex; align-items: center; gap: 16px; padding-left: 30px; font-family: "Lexend", sans-serif; font-weight: 600; font-size: 32px; color: #f4f4f4; }
$ .s09-av { width: 58px; height: 58px; border-radius: 16px; border: 4px solid #57c4e5; box-sizing: border-box; position: relative; }
$ .s09-av:before, .s09-av:after { content: ""; position: absolute; top: 18px; width: 9px; height: 9px; border-radius: 50%; background: #57c4e5; }
$ .s09-av:before { left: 12px; } $ .s09-av:after { right: 12px; }
$ .s09-g { white-space: normal; width: 420px; font-size: 36px; }
$ .s09-ok { position: absolute; right: 36px; top: 470px; font-family: "IBM Plex Mono", monospace; font-weight: 500; font-size: 30px; letter-spacing: 0.1em; color: #2ec27e; }
@@HTML
<div class="cartel c-rojo s09-prom s09-p1" style="top: 640px; transform: rotate(-3deg)">CONTESTO TODO<div class="s09-tacha"></div></div>
<div class="cartel c-rojo s09-prom s09-p2" style="top: 830px; transform: rotate(2deg)">LLAMO A TODOS<div class="s09-tacha"></div></div>
<div class="cartel c-rojo s09-prom s09-p3" style="top: 1020px; transform: rotate(-2deg)">ME ACUERDO DE ELSA<div class="s09-tacha"></div></div>
<div class="s09-cel">
  <div class="s09-cab"><div class="s09-av"></div>Agente de IA · Tu local</div>
  <div class="hora s09-hora" style="left: 0; right: 0; top: 124px; text-align: center; color: #8b97ad">SOFÍA · PREGUNTÓ AYER</div>
  <div class="globo g-cli s09-g s09-g0" style="left: 26px; top: 170px; width: 360px">¿Cuánto sale el de 2 plazas?</div>
  <div class="globo g-loc s09-g s09-g1" style="right: 26px; top: 310px">Hola Sofi, ¿te quedó alguna duda con el presupuesto?</div>
  <div class="s09-ok">✓✓ ENVIADO HOY</div>
</div>
@@JS
      const PROMETO = 0.33, HAGO = 1.16, PREGUNTO = 2.08, COMPRO = 2.75, ESCRIBO = 3.41, HOY = 3.83;
      // cuadro 0: las promesas del dueño en pantalla
      qa(".s09-prom").forEach((p, i) => tl.fromTo(p, { opacity: 0.4, x: i % 2 ? 80 : -80 }, { opacity: 1, x: 0, duration: 0.25, ease: "power3.out" }, i * 0.05));
      qa(".s09-tacha").forEach((t, i) => {
        gsap.set(t, { scaleX: 0 });
        tl.to(t, { scaleX: 1, duration: 0.18, ease: "power2.out" }, PROMETO + 0.1 + i * 0.15);
      });
      tl.to(qa(".s09-prom"), { opacity: 0, y: 260, rotation: 14, duration: 0.35, stagger: 0.05, ease: "power2.in" }, HAGO - 0.3);
      // "lo hago": el celular del agente
      gsap.set(q(".s09-cel"), { opacity: 0 });
      tl.fromTo(q(".s09-cel"), { opacity: 0, y: 160 }, { opacity: 1, y: 0, duration: 0.35, ease: "back.out(1.4)", immediateRender: false }, HAGO);
      pop(q(".s09-hora"), HAGO + 0.3);
      pop(q(".s09-g0"), HAGO + 0.4);
      tl.to(q(".s09-hora"), { color: "#e63946", duration: 0.1 }, COMPRO);
      gsap.set(q(".s09-g1"), { opacity: 0 });
      tl.fromTo(q(".s09-g1"), { opacity: 0, x: 80 }, { opacity: 1, x: 0, duration: 0.3, ease: "back.out(1.6)", immediateRender: false }, ESCRIBO - 0.1);
      pop(q(".s09-ok"), HOY);
      tl.to(q(".s09-cel"), { rotation: -2, duration: 0.3, yoyo: true, repeat: 1, ease: "sine.inOut" }, HOY);
      etiquetas([["PROMESAS", 0.05], ["HECHOS", HAGO], ["PREGUNTÓ Y NO COMPRÓ", PREGUNTO], ["SEGUIMIENTO", HOY]]);
@@SFX
[{"t": 0.45, "sfx": "key-press", "vol": 0.3}, {"t": 0.6, "sfx": "key-press", "vol": 0.3}, {"t": 0.75, "sfx": "key-press", "vol": 0.3}, {"t": 0.9, "sfx": "whoosh", "vol": 0.22}, {"t": 1.6, "sfx": "pop", "vol": 0.25}, {"t": 3.31, "sfx": "notification", "vol": 0.3}]
