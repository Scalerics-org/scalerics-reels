@@DUR
6.12
@@CSS
$ .s15-tit { top: 592px; font-size: 128px; color: #f4f4f4; letter-spacing: 0.02em; }
$ .s15-pie { position: absolute; left: 290px; top: 1150px; width: 500px; text-align: center; font-family: "Outfit", sans-serif; font-weight: 900; font-size: 44px; line-height: 1.05; color: #f4f4f4; }
$ .s15-arroba { position: absolute; left: 700px; top: 700px; width: 200px; text-align: center; font-family: "Outfit", sans-serif; font-weight: 900; font-size: 200px; line-height: 1; color: #f2c14e; }
$ .s15-sello { left: 590px; top: 960px; font-size: 64px; padding: 4px 18px 2px; border-width: 7px; }
@@HTML
<svg class="lienzo" viewBox="0 0 1080 1920" aria-hidden="true">
  <g class="s15-poster">
    <rect x="290" y="740" width="500" height="520" rx="12" fill="#e63946" stroke="#f4f4f4" stroke-width="6" />
    <svg x="290" y="740" width="500" height="520" viewBox="290 740 500 520" overflow="hidden">
      {{duenio 540 1080 1.25 s15-d}}
    </svg>
    <rect x="290" y="1140" width="500" height="120" fill="#0b1a3a" stroke="#f4f4f4" stroke-width="6" />
  </g>
</svg>
<div class="grande s15-tit">ETIQUETÁ</div>
<div class="s15-pie">AL QUE PROMETE<br />Y NO LLAMA</div>
<div class="s15-arroba">@</div>
<div class="sello s15-sello">FALSO</div>
@@JS
      const CANDIDATO = 0.62, PROMETE = 1.34, NO = 2.14, LLAMA = 2.32;
      tl.fromTo(q(".s15-tit"), { opacity: 0.3, scale: 1.4 }, { opacity: 1, scale: 1, duration: 0.25, ease: "power3.out" }, 0);
      tl.fromTo(q(".s15-poster"), { opacity: 0.4, y: 120, rotation: 4, svgOrigin: "540 1000" }, { opacity: 1, y: 0, rotation: -2, svgOrigin: "540 1000", duration: 0.45, ease: "back.out(1.4)" }, 0);
      pop(q(".s15-pie"), PROMETE - 0.1);
      tl.to(q(".s15-pie"), { rotation: -2, duration: 0.01 }, PROMETE);
      gsap.set(q(".s15-arroba"), { opacity: 0 });
      tl.fromTo(q(".s15-arroba"), { opacity: 0, y: -300, rotation: -30 }, { opacity: 1, y: 0, rotation: 12, duration: 0.45, ease: "bounce.out", immediateRender: false }, CANDIDATO - 0.1);
      sello(q(".s15-sello"), LLAMA + 0.1, -12);
      // se queda vivo hasta el final
      tl.to(q(".s15-arroba"), { scale: 1.12, duration: 0.45, yoyo: true, repeat: 5, ease: "sine.inOut" }, LLAMA + 0.6);
      tl.to(q(".s15-tit"), { scale: 1.04, duration: 0.6, yoyo: true, repeat: 3, ease: "sine.inOut" }, LLAMA + 0.4);
      tl.to(q(".s15-d-bigote"), { y: -4, duration: 0.12, yoyo: true, repeat: 7 }, LLAMA + 0.5);
      etiquetas([["EN LOS COMENTARIOS", 0.3]]);
@@SFX
[{"t": 0.0, "sfx": "impact-bass-1", "vol": 0.35, "max": 0.7}, {"t": 0.62, "sfx": "pop", "vol": 0.35}, {"t": 2.3, "sfx": "impact-bass-2", "vol": 0.35, "max": 0.5}, {"t": 2.5, "sfx": "risas", "vol": 0.22, "max": 1.5}, {"t": 4.3, "sfx": "aplausos", "vol": 0.25, "max": 1.75}]
